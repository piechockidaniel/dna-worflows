{
  "realm": "DnA Workflows",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "DnA Workflows-viewer",
        "description": "read everything"
      },
      {
        "name": "DnA Workflows-analyst",
        "description": "design, test and run workflows (domain analyst)"
      },
      {
        "name": "DnA Workflows-reviewer",
        "description": "review drafts"
      },
      {
        "name": "DnA Workflows-publisher",
        "description": "publish approved drafts"
      },
      {
        "name": "DnA Workflows-operator",
        "description": "operate runs, freeze/unfreeze, ask AI triage"
      },
      {
        "name": "DnA Workflows-approver",
        "description": "approve proposals"
      },
      {
        "name": "DnA Workflows-agent",
        "description": "machine clients (MCP): read, start, propose"
      },
      {
        "name": "DnA Workflows-admin",
        "description": "everything"
      }
    ]
  },
  "clients": [
    {
      "clientId": "DnA Workflows-api",
      "name": "DnA Workflows API (resource server)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "DnA Workflows-studio",
      "name": "DnA Workflows Studio",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/studio/*",
        "http://localhost:5173/studio/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "DnA Workflows-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "DnA Workflows-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "DnA Workflows-mcp-agent",
      "name": "MCP agent (client credentials)",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me-agent-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "DnA Workflows-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "DnA Workflows-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "anna",
      "enabled": true,
